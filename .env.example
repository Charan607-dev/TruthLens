# GEMINI_API_KEY: Required for optional server-side independent fact-check grounding.
# Server-only secret — NEVER prefix with VITE_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet or full-stack server is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: Optional public backend base URL when deploying the frontend separately
# (e.g. Render Static Site pointing to your Render backend web service).
# Leave empty for integrated same-origin Express + Vite mode.
VITE_API_URL=""

# ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins for CORS
# (e.g. https://truthlens-ai-frontend.onrender.com).
ALLOWED_ORIGINS=""

# JWT_SECRET: Secret key used to sign session tokens in Express mode.
JWT_SECRET="change-me-in-production-use-long-random-hex"

# SUPABASE (Optional for production PostgreSQL + Auth + RLS deployment):
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
